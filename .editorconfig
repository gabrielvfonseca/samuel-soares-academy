# EditorConfig: https://editorconfig.org
# Root marker — EditorConfig tools walk up to this file and stop.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,css,html,svg}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
