{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/drizzle"
  ],
  "files": {
    "includes": [
      "!**/.next",
      "!**/.turbo",
      "!**/node_modules",
      "!**/next-env.d.ts",
      "!**/*.svg",
      "!pnpm-lock.yaml",
      "!supabase/migrations",
      "!apps/admin/src/integrations/supabase/types.ts"
    ]
  },
  "linter": {
    "rules": {
      // Legacy admin code (ported from Lovable) trips these at scale. They stay visible as
      // warnings and can be tightened incrementally; they do not fail CI.
      "performance": {
        "noJsxPropsBind": "warn",
        "noNamespaceImport": "warn",
        "useTopLevelRegex": "warn",
        "noAwaitInLoops": "warn",
        "noImgElement": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn",
        "useSemanticElements": "warn",
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn"
      },
      "suspicious": {
        "noLeakedRender": "warn",
        "noShadow": "warn",
        "noArrayIndexKey": "warn",
        "noUnnecessaryConditions": "warn",
        "noAlert": "warn",
        "useAwait": "warn",
        "noNestedPromises": "warn",
        "useBaseline": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noForEach": "warn",
        "noVoid": "warn"
      },
      "style": {
        "noNestedTernary": "warn",
        "noIncrementDecrement": "warn",
        "useDestructuring": "warn",
        "noNonNullAssertion": "warn",
        "useNamedCaptureGroup": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useImageSize": "warn"
      }
    }
  },
  "overrides": [
    {
      // shadcn/ui vendored components: formatted, but not linted (regenerated by the shadcn CLI).
      "includes": ["packages/ui/src/components/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Barrel files are intentional public entry points of workspace packages.
      "includes": [
        "packages/*/src/index.ts",
        "packages/*/src/schema/index.ts",
        "packages/ui/src/icons.ts",
        "packages/ui/src/lib/*.ts",
        "apps/site/src/lib/json-ld.tsx",
        "apps/site/src/lib/security.ts"
      ],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off", "noReExportAll": "off" }
        }
      }
    }
  ]
}
