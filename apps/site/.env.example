# Cloudflare Workers env — set real values in the CF dashboard after deploy.
# The placeholder values in cloudflare.config.ts are for local dev only.
#
# See apps/site/src/types/cloudflare-workers.d.ts for the full typed list.

# Public origin of the site app (inlined into the browser bundle at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics measurement ID (optional; leave blank to disable GA)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# WhatsApp Business (used by the contact form to build a wa.me deep link)
WHATSAPP_BUSINESS_PHONE=+351900000000

# Resend API — transactional email (contact form + notifications)
RESEND_API_KEY=
CONTACT_EMAIL_FROM=no-reply@samuelsoares.academy
CONTACT_EMAIL_TO=geral@samuelsoares.academy
