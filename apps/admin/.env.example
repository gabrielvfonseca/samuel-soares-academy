# Cloudflare Workers env — set real values in the CF dashboard after deploy.
# The placeholder values in cloudflare.config.ts are for local dev only.
#
# See apps/admin/src/types/cloudflare-workers.d.ts for the full typed list.

# Better Auth — 32+ random chars. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin of the admin app (used for Better Auth callbacks + cookies)
BETTER_AUTH_URL=http://localhost:9001

# Comma-separated list of trusted origins for Better Auth (CSRF protection).
# Local dev + the production origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:9001,http://127.0.0.1:9001

# Shared secret required by the restricted internal login gate
CODIGO_ACESSO_INTERNO=

# Lovable AI gateway API key (assistant + slot suggestions)
LOVABLE_API_KEY=

# Resend API key (transactional email)
RESEND_API_KEY=

# Secret required by the /api/public/cron/* routes (Bearer token)
TREINOS_CRON_SECRET=
