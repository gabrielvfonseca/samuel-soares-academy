{
  "extends": "@ssa/typescript-config/nextjs.json",
  "compilerOptions": {
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".cloudflare/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
