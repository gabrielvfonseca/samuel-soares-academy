# App URL (required in production; defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics (optional; defaults to G-PV3P9VPBMX if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PV3P9VPBMX

# WhatsApp Business API Configuration
# Get these from Meta Business Suite > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_PHONE=+351912345678
