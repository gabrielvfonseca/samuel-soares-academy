# pnpm + Turborepo workspace settings
#
# Shared workspace lockfile — one lockfile at the repo root, not per-workspace.
shared-workspace-lockfile = true

# Automatically install peer dependencies (Next.js / React ecosystem).
auto-install-peers = true

# Strict peer dependency checking — fail the install on conflicting peers.
strict-peer-dependencies = false

# Never install dependencies with the same version as a transitive dep
# unless explicitly requested (keeps the lockfile deterministic).
dedupe-peer-dependents = true

# Do not hoist everything into the root node_modules (pnpm default;
# stated here so the intent is explicit and survives tooling upgrades).
shamefully-hoist = false
