{
  "name": "samuel-soares-academy",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@repo/site",
    "dev:gestao": "turbo run dev --filter=@repo/gestao",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:migrate": "turbo run db:migrate --filter=@repo/db",
    "db:push": "turbo run db:push --filter=@repo/db",
    "db:pull": "turbo run db:pull --filter=@repo/db",
    "db:studio": "turbo run db:studio --filter=@repo/db",
    "db:check": "turbo run db:check --filter=@repo/db",
    "supabase": "supabase",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "supabase": "^2.0.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "prettier": "^3.8.1"
  }
}
