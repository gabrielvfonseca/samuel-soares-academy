{
  "name": "samuel-soares-academy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:check": "turbo run db:check --filter=@repo/database",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:migrate": "turbo run db:migrate --filter=@repo/database",
    "db:pull": "turbo run db:pull --filter=@repo/database",
    "db:push": "turbo run db:push --filter=@repo/database",
    "db:studio": "turbo run db:studio --filter=@repo/database",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@repo/admin",
    "dev:site": "turbo run dev --filter=@repo/site",
    "fix": "ultracite fix",
    "lint": "turbo run //#check",
    "prepare": "husky",
    "supabase": "supabase",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,md,mdx,yaml,yml}": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "supabase": "^2.0.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
