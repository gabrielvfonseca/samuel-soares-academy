{
  "name": "samuel-soares-academy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:check": "turbo run db:check --filter=@ssa/database",
    "db:deploy": "turbo run db:deploy --filter=@ssa/database",
    "db:generate": "turbo run db:generate --filter=@ssa/database",
    "db:local": "turbo run db:local --filter=@ssa/database",
    "db:studio": "turbo run db:studio --filter=@ssa/database",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@ssa/admin",
    "dev:site": "turbo run dev --filter=@ssa/site",
    "fix": "ultracite fix",
    "lint": "turbo run //#check",
    "prepare": "husky",
    "test": "turbo run test",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,md,mdx,yaml,yml}": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "tsc-rs": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
