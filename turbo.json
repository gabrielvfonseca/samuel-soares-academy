{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "VITE_*",
        "INTERNAL_ACCESS_CODE",
        "CRON_SECRET",
        "LOVABLE_API_KEY",
        "RESEND_API_KEY",
        "CONTACT_EMAIL_*",
        "WHATSAPP_*",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:local": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:check": {
      "cache": false
    },
    "db:smoke": {
      "cache": false
    },
    "test": {
      "cache": false,
      "dependsOn": []
    },
    "//#check": {
      "inputs": ["$TURBO_DEFAULT$", "biome.jsonc"]
    },
    "//#fix": {
      "cache": false
    }
  }
}
