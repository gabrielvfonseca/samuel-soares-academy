{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:check": "drizzle-kit check",
    "db:deploy": "wrangler d1 migrations apply ssa-db",
    "db:deploy:preview": "wrangler d1 migrations apply ssa-db --remote=false",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply ssa-db --local",
    "db:smoke": "wrangler d1 execute ssa-db --command='SELECT 1'",
    "db:studio": "drizzle-kit studio",
    "transit": "echo transit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.43.0"
  }
}
